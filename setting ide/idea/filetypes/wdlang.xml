<filetype binary="false" default_extension="wdl" description="WDLang files" name="WDLang">
  <highlighting>
    <options>
      <option name="LINE_COMMENT" value="//" />
      <option name="COMMENT_START" value="/*" />
      <option name="COMMENT_END" value="*/" />
      <option name="HEX_PREFIX" value="0x" />
      <option name="NUM_POSTFIXES" value="" />
      <option name="HAS_BRACES" value="true" />
      <option name="HAS_BRACKETS" value="true" />
      <option name="HAS_PARENS" value="true" />
      <option name="HAS_STRING_ESCAPES" value="true" />
      <option name="LINE_COMMENT_AT_START" value="false" />
    </options>
    <!-- Все зарезервированные слова из lexer/TokenType.java. Словесные операторы
         in, is и has тоже здесь: лексер не позволяет использовать их как имена. -->
    <keywords keywords="as;break;case;catch;class;const;continue;def;defer;do;else;finally;for;has;if;import;in;is;match;new;property;return;super;synchronized;this;throw;trait;try;use;while;with;yield" ignore_case="false" />
    <!-- Функции, доступные в базовой среде и стандартной библиотеке CLI. -->
    <keywords2 keywords="abs;len;like;pow;print;println;sqrt;typeof" ignore_case="false" />
    <!-- Литеральные значения — не смешиваем их с управляющими словами. -->
    <keywords3 keywords="false;null;true" ignore_case="false" />
    <!-- Дескрипторы типов из прелюдии и классы стандартной библиотеки. -->
    <keywords4 keywords="Array;Bool;Class;File;Function;Module;Null;Number;Object;Random;Range;String;Trait" ignore_case="false" />
  </highlighting>
  <extensionMap>
    <mapping ext="wdl" />
  </extensionMap>
</filetype>
