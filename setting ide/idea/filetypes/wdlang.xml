<filetype binary="false" default_extension="wdl" description="WDLang files" name="WDLang">
  <highlighting>
    <options>
      <option name="LINE_COMMENT" value="//" />
      <option name="COMMENT_START" value="/*" />
      <option name="COMMENT_END" value="*/" />
      <option name="HEX_PREFIX" value="0x" />
      <option name="NUM_POSTFIXES" value="" />
      <option name="HAS_BRACES" value="true" />
      <option name="HAS_BRACKETS" value="true" />
      <option name="HAS_PARENS" value="true" />
      <option name="HAS_STRING_ESCAPES" value="true" />
      <option name="LINE_COMMENT_AT_START" value="false" />
    </options>
    <keywords keywords="as;break;case;class;const;continue;do;else;for;fun;if;import;in;is;match;new;return;trait;while;with" ignore_case="false" />
    <keywords2 keywords="abs;len;pow;print;println;sqrt;typeof" ignore_case="false" />
    <keywords3 keywords="false;null;super;this;true" ignore_case="false" />
    <keywords4 keywords="File;Random" ignore_case="false" />
  </highlighting>
  <extensionMap>
    <mapping ext="wdl" />
  </extensionMap>
</filetype>
