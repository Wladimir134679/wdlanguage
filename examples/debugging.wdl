// Отладка: скрипт, по которому удобно шагать.
// Запуск как обычно: wdl examples/debugging.wdl
//
// Своего синтаксиса у отладки нет — скрипт про неё не знает. Точки останова ставит
// тот, кто отлаживает: приложение (script.debugger()) или редактор по протоколу DAP.
// Здесь собрано то, на чём отладчик видно: кадры, вложенные вызовы, поля экземпляра,
// ошибка и второй поток. Подробности — в docs/debugging.md.

import sys.thread as th

// --- 1. Кадры и локальные переменные ----------------------------------------
// Точка на строке `total = total + i`: в кадре видны limit, total и i, и на каждом
// круге они разные. Выражение `total + i` считается прямо в кадре — тем самым
// потоком, который стоит.

def sum(limit) {
    total = 0
    i = 1
    while (i <= limit) {
        total = total + i
        i = i + 1
    }
    return total;
}

// --- 2. Шаг внутрь и наружу -------------------------------------------------
// average зовёт sum: «шаг внутрь» на строке ниже уводит в тело sum, «шаг наружу»
// возвращает сюда с готовым значением. Кадров в этот момент два — average и файл.

def average(limit) => sum(limit) / limit

println("сумма до 10 = ", sum(10))
println("среднее = ", average(10))

// --- 3. Класс: поля экземпляра в панели переменных ---------------------------
// Искать их отдельно не надо: у метода внешней областью лежит область экземпляра,
// и `this` находится обычным поиском имени.

class Counter(start) {
    def add(step) {
        this.start = this.start + step
        return this.start;
    }
}

counter = new Counter(100)
counter.add(5)
println("счётчик = ", counter.add(7))

// --- 4. Ошибка: останов до раскрутки ----------------------------------------
// С включённым stopOnError поток встанет внутри divide — там, где ошибка случилась
// и где кадры ещё целы, — а не здесь, где её ловит catch. Останов ошибку не отменяет:
// после возобновления она долетит до catch той же дорогой.

def divide(a, b) => a / b

try {
    divide(10, 0)
} catch (e is ArithmeticError) {
    println("поймали: ", e.message)
}

// --- 5. Второй поток ---------------------------------------------------------
// Под политикой «все» встают оба; шагает при этом один — тот, которому шаг назначен.

worker = th.spawn("counting", def () => sum(1000))
println("в потоке насчитали ", worker.join())
