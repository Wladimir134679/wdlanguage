// Распаковка и пропуск. Запуск: wdl examples/unpack.wdl
//
// Знак стоит на источнике, а не на списке имён: '*' раскладывает по позициям,
// '**' — по именам. Те же два знака, что и в вызове — f(*args), f(**named), —
// и в том же значении, так что нового слова язык не заводит вовсе.

// --- по позициям: массив ---------------------------------------------------------

x, y = *[10, 20]
println("x = ", x, ", y = ", y)

// '_' — пропуск: позицию занимает, значения не хранит, повторяется сколько угодно.
// '*_' — явный отказ от остатка.
row = [1, 2, 3, 4, 5, 6, 7, 8]
first, second, _, _, _, sixth, *_ = *row
println("первое ", first, ", второе ", second, ", шестое ", sixth)

// Остаток с именем собирается в новый массив
head, *tail = *row
println("голова ", head, ", хвост ", tail)

// Даже одна цель — это проверка: «здесь ровно один элемент»
only = *[42]
println("единственное ", only)

// --- по позициям: экземпляр (порядок задаёт заголовок) ----------------------------

class Vec3(x, y, z) { }

point = new Vec3(1, 2, 3)
a, b, c = *point
println("вектор ", a, " ", b, " ", c)

// --- по именам --------------------------------------------------------------------

// Ключ 'y' просто не назван — лишние ключи в '**'-форме не ошибка
config = {host: "localhost", port: 8080, tls: true, retries: 3}
host, port = **config
println(host, ":", port)

// Остаток — новый объект из всего неназванного. Писать его не обязательно,
// но он удобен ровно тем, что уходит дальше тем же '**'.
host, port, **options = **config
println("остальное: ", options)

def connect(host, port, tls = false, retries = 0) =>
    host + ":" + port + (tls ? " (tls)" : "") + ", попыток " + retries
println(connect(host, port, **options))

// Экземпляр читается и по именам полей — обеими формами, значит, сразу
x, z = **point
println("x и z: ", x, " ", z)

// Ключ ищется наличием, а не значением: {x: null} — это «ключ есть, значение null»
value = **{value: null}
println("value = ", value)

// --- цель — та же, что у обычного присваивания ------------------------------------

velocity = [3, 4]
p = {}
p.x, p.y = *velocity
println("p = ", p)

grid = [0, 0]
grid[0], grid[1] = *[7, 8]
println("grid = ", grid)

// В '**'-форме ключом служит хвостовое имя цели: p.x берётся из vec.x
vec = {x: 100, y: 200, z: 300}
p.x, p.y = **vec
println("p = ", p)

// --- источник — любое выражение ----------------------------------------------------

// Маркер относится ко всей цепочке, а не к первому звену, и считается она один раз
reacts = [{center: def() => new Vec3(4, 5, 6)}]
cx, cy, cz = *reacts[0].center()
println("центр ", cx, " ", cy, " ", cz)

// --- список справа без маркера: попарно --------------------------------------------

left = "лево"
right = "право"
left, right = right, left
println(left, " и ", right)

// Раскрытие в таком списке разрешено — то же самое, что в аргументах вызова
one, two, three = 1, *[2, 3]
println(one, two, three)

// Одна дырка — это «вызови и выброси»
def log() {
    println("побочный эффект случился")
    return 1;
}
_ = log()

// --- перебор с ключом ---------------------------------------------------------------

// Первое имя — то, ЧЕМ обращаются: row[i], config[k]. Отсюда массив и строка дают
// номер, объект и экземпляр — ключ.
for (i, tile in ["земля", "вода", "камень"]) println(i, ": ", tile)
for (key, setting in config) println(key, " = ", setting)
for (field, held in point) println(field, " = ", held)
for (i, letter in "wdl") println(i, letter)

// Ключ не нужен — на его месте пропуск
for (_, setting in config) print(setting, " ")
println()

// Разложить сам элемент — отдельная строка в теле: список имён в заголовке
// нигде не значит двух разных вещей
points = [[1, 2], [3, 4], [5, 6]]
for (pair in points) {
    px, py = *pair
    println("точка ", px, ":", py)
}

// --- '_' как параметр -----------------------------------------------------------------

// Полезен там, где сигнатуру диктует не автор: обработчик, декоратор, обратный вызов
def onClick(_, event) => "обработано: " + event
println(onClick("кнопка", "click"))

// В заголовке класса дырка занимает позицию, но поля не заводит
class Slot(_, y) { }
println(new Slot("забыть", "запомнить"))

// --- что здесь ошибка -------------------------------------------------------------------

// x, y, z = *[1, 2]     // распаковка ждёт 3 значения, а массив даёт 2
// x, y = *[1, 2, 3]     // ...берёт 2, а массив даёт 3; остаток пишется 'x, y, *rest' или 'x, y, *_'
// x, y = *config        // по позициям распаковывается массив или экземпляр, а здесь объект
// x, y = *"hi"          // ...а здесь строка; символ берётся по номеру: text[0]
// host, missing = **config   // в объекте нет ключа 'missing'
// x, _, z = **vec       // в списке по именам пропускать нечего: порядок там ничего не значит
// host, **_ = **config  // '**_' ничего не делает: лишние ключи и так не ошибка
// grid[i] = **config    // в '**'-форме ключ берётся из имени цели, а у 'grid[i]' имени нет
// x, y += *velocity     // распаковка не сочетается с '+='
// println(_)            // '_' — это пропуск, а не переменная: читать его нельзя
// for (i, n in 0..10) { }    // у диапазона нет ключа: номер прохода здесь и есть значение
// for (a, b, c in row) { }   // в 'for' бывает одно имя или два
