// Функции: объявление, return, стрелка, анонимные и замыкания.
// Запуск: wdl examples/functions.wdl

// Объявления верхнего уровня помечаются до выполнения, поэтому вызов стоит выше
// объявления и это работает: сначала главное, потом вспомогательное.
println("сумма(2, 3) = ", сумма(2, 3))

fun сумма(a, b) {
    return a + b;
}

// Тело из одной инструкции — фигурные скобки не нужны
fun удвоить(x) return x * 2;

// Тело-выражение: => вместо return, и точка с запятой не нужна
fun площадь(ширина, высота) => ширина * высота

println("удвоить(21) = ", удвоить(21))
println("площадь(3, 4) = ", площадь(3, 4))

// Функция без return не возвращает ничего — то есть null
fun поздороваться(имя) {
    println("Привет, ", имя, "!")
}
println("поздороваться вернула ", typeof(поздороваться("wdl")))

// --- рекурсия ---------------------------------------------------------------

fun факториал(n) => n <= 1 ? 1 : n * факториал(n - 1)
println("5! = ", факториал(5))

// Взаимная рекурсия: обе функции найдены до выполнения
fun чётное(n) => n == 0 ? true : нечётное(n - 1)
fun нечётное(n) => n == 0 ? false : чётное(n - 1)
println("7 нечётное? ", нечётное(7))

// --- return из глубины ------------------------------------------------------

fun найти(значения, что) {
    for (i = 0; i < len(значения); i += 1) {
        if (значения[i] == что) {
            return i;            // выходит и из цикла, и из функции
        }
    }
    return -1;
}
println("индекс 'б' = ", найти(["а", "б", "в"], "б"))
println("индекс 'я' = ", найти(["а", "б", "в"], "я"))

// --- функция это обычное значение -------------------------------------------

операции = {
    "+": fun(a, b) => a + b,
    "-": fun(a, b) => a - b,
    "*": fun(a, b) => a * b
}
for (знак in операции) {
    println("10 ", знак, " 4 = ", операции[знак](10, 4))
}

// Функция, принимающая функцию
fun применить_дважды(f, значение) => f(f(значение))
println("удвоить дважды 5 = ", применить_дважды(удвоить, 5))

// --- замыкания --------------------------------------------------------------

// Возвращённая функция помнит область, в которой её объявили, — и переменную,
// а не её снимок: каждый вызов тика видит изменение предыдущего.
fun счётчик() {
    сколько = 0
    return fun() {
        сколько += 1
        return сколько;
    };
}
тик = счётчик()
println("тики: ", тик(), тик(), тик())

// Свой счётчик у каждого вызова
другой = счётчик()
println("другой тик: ", другой())

// --- область видимости ------------------------------------------------------

глобальная = "снаружи"

fun поработать() {
    локальная = "внутри"
    println("вижу внешнюю: ", глобальная)
    глобальная = "изменена изнутри"     // имя есть снаружи — меняется именно оно
    return локальная;
}

println("вернула: ", поработать())
println("глобальная теперь: ", глобальная)
// println(локальная)   // ошибка: переменная 'локальная' не определена
