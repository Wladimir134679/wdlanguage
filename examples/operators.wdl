// Перегрузка операторов: класс даёт свой смысл '+', '<', 'in' и остальным.
// Описание — в docs/expressions.md, раздел «Перегрузка операторов».
//
// Главное правило: ядро важнее. Оператор спрашивают только тогда, когда ядро
// не справилось, поэтому 24 * 23 не делает ни одного поиска члена, а сломать
// арифметику чисел из модуля нельзя.

// --- класс со своими операторами -------------------------------------------------

class Point(x, y) {
    // Получатель — левый операнд, единственный параметр — правый.
    def `+`(right) {
        if (right is Number) return new Point(x + right, y + right);
        return new Point(x + right.x, y + right.y);
    }

    def `/`(right) {
        if (right is Number) return new Point(x / right, y / right);
        return new Point(x / right.x, y / right.y);
    }

    // Получатель оказался справа: '12 / p'. Параметром приходит левый операнд,
    // а тело возвращает ответ всего выражения так, как оно написано.
    mirror def `/`(left) {
        if (left is Number) return new Point(left / x, left / y);
        return new Point(left.x / x, left.y / y);
    }

    // Унарный отличается арностью, а не именем.
    def `-`() => new Point(0 - x, 0 - y)

    // Один член на '==' и '!=', один на все четыре сравнения и на сортировку.
    def `==`(right) => right is Point && x == right.x && y == right.y

    def `<=>`(right) => (x * x + y * y) - (right.x * right.x + right.y * right.y)

    def show() => "(" + x + ", " + y + ")"
}

p1 = new Point(6, 6)
p2 = new Point(2, 2)

println((p1 / p2).show())           // (3, 3)
println((p1 / 6).show())            // (1, 1)
println((12 / p1).show())           // (2, 2) — зеркальный оператор
println((p1 + p2).show())           // (8, 8)
println((-p1).show())               // (-6, -6) — унарный

// Составное присваивание зовёт тот же член '+': отдельного для него не бывает.
acc = new Point(0, 0)
acc += p1
println(acc.show())                 // (6, 6)

// --- равенство и сравнение -------------------------------------------------------

println(p1 == new Point(6, 6))      // true — член '=='
println(p1 != p2)                   // true — тот же член, ответ отрицается
println(p1 > p2)                    // true — член '<=>'
println(p1 <= p2)                   // false — он же

// Сортировка ходит в тот же '<=>', что и оператор: разойтись им нечем.
points = [p1, p2, new Point(4, 4)]
println(points.sorted[0].show())    // (2, 2)

// И 'contains' сравнивает тем же членом '=='.
println(points.contains(new Point(4, 4)))   // true

// В match образец — это буквально тот же оператор.
println(match (p1) {
    case > p2 => "дальше"
    else      => "ближе"
})                                  // дальше

// --- расширение ------------------------------------------------------------------

// То же самое, но снаружи и для чужого класса. Поля получателя видны через 'this' —
// как у всякого члена расширения.
extend Point {
    def `*`(right) => new Point(this.x * right, this.y * right)

    mirror def `*`(left) => new Point(left * this.x, left * this.y)
}

println((p1 * 2).show())            // (12, 12)
println((23 * new Point(1, 2)).show())  // (23, 46) — зеркальный у Point
println(24 * 23)                    // 552: ядро справилось, ничего не спрашивалось

// --- контейнер -------------------------------------------------------------------

// Член 'in' объявляется на контейнере и закрывает все четыре записи.
class Deck(cards) {
    def `in`(card) => card in cards
}

d = new Deck(["ace", "king"])
println("ace" in d)                 // true
println(d has "ace")                // true — та же запись с другой стороны
println("joker" !in d)              // true — тот же член, ответ отрицается
println(d.has("ace"))               // true — и член 'has' отвечает им же

// Перегрузка 'in' не делает класс перебираемым: перебор идёт по полям экземпляра.
for (key in d) println(key)         // cards

// --- трейт -----------------------------------------------------------------------

// Оператор в трейте бывает и требованием, и готовой реализацией.
trait Ordered {
    def `<=>`(other)                    // требование: класс обязан объявить
}

trait Sized {
    def `<=>`(other) => size - other.size   // реализация: класс получает готовую
}

class Word(size) with Sized {}

println(new Word(2) < new Word(5))  // true — сравнение досталось от трейта

class Money(amount) with Ordered {
    def `<=>`(other) => amount - other.amount
}

println(new Money(10) > new Money(3))   // true

// --- где перегрузки не будет -----------------------------------------------------

// Строка съедает '+': ядро справляется с чем угодно справа от строки, поэтому
// член '+' у класса строку никогда не увидит. Своё представление — это display.
println("итого: " + p1.show())      // итого: (6, 6)

// Ядро уже умеет — переопределить нельзя. Это и есть цена правила запасного пути.
println(2 + 2)                      // 4

// А вот чего не бывает совсем (все строки — ошибки разбора):
//
// def `+`(a, b) => a          // локальных операторов в языке нет
// def `!=`(r) => r            // производные записи не объявляют: есть член '=='
// def `<`(r) => r             // четыре сравнения закрывает один '<=>'
// def `&&`(r) => r            // ленивый оператор не перегружается
// mirror def `in`(r) => r     // у 'in' обеих сторон и так две записи
