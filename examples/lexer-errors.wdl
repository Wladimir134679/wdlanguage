// Файл специально сломан: показывает, что лексер не падает на первой ошибке,
// а собирает все проблемы за один проход.
// Запуск:  wdl examples/lexer-errors.wdl   (завершится с кодом 1)

всего = @значение              // неизвестный символ
размер = 10px                  // буква прилипла к числу
цвет = 0x                      // шестнадцатеричное без цифр
кривое = 1_000_                // разделитель в конце числа
текст = "забыли закрыть кавычку
экран = "неизвестный \q экран"
код = "обрезанный \u12"

/* этот комментарий никто не закрыл
println("после ошибок разбор продолжается")
