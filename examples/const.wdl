// Константы: const NAME = value — имя, которое нельзя перезаписать.
// Запуск: wdl examples/const.wdl
// Подробности: docs/statements.md

const TAX_RATE = 0.2

fun total(price, count) => price * count * (1 + TAX_RATE)
println("итого: ", total(100, 2))

// const LIMIT = 10
// LIMIT = 20
// ошибка выполнения: 'LIMIT' нельзя присвоить: это константа, её значение
// задаётся один раз при объявлении. Составное 'LIMIT += 1' — то же самое

// --- заморожено имя, а не содержимое ----------------------------------------

// Значение не знает, в какой переменной лежит, — иначе один и тот же массив
// в двух именах вёл бы себя по-разному
const items = [1, 2]
items[0] = 5
println("массив меняется: ", items)

const settings = {theme: "dark"}
settings.theme = "light"
println("объект меняется: ", settings)

// settings = {}
// а вот имя — нет: это ошибка

// --- затенение во вложенной области -----------------------------------------

// const заводит имя в своей области, как fun: внешняя константа не страдает
const rate = 1
{
    const rate = 2
    println("внутри блока: ", rate)
}
println("снаружи: ", rate)

fun withOwnRate() {
    const rate = 3
    return rate;
}
println("в функции: ", withOwnRate(), ", снаружи по-прежнему ", rate)

// const rate = 5
// ошибка: в этой области уже есть константа с таким именем

// --- константа — обычное значение -------------------------------------------

// Пространство имён одно, поэтому заморозить можно и функцию
const format = fun(value) => "[" + value + "]"
println(format("готово"))

// const twice = fun(x) => x * 2
// fun twice(x) => x + x
// ошибка на строке с fun: объявление константу не перекрывает

// --- константа не помечается до выполнения ----------------------------------

// У неё выражение-инициализатор, вычислять его до первой инструкции скрипта
// значило бы завести вторую, невидимую фазу выполнения. Поэтому функция выше
// константу видит, но только если вызвана после её объявления
fun showLimit() => LIMIT
const LIMIT = 7
println("предел: ", showLimit())
