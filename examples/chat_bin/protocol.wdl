// Двоичный протокол чата: один формат кадра на клиента и на сервер.
//
// Сам по себе файл ничего не делает — его импортируют:
//     import protocol as proto
// и клиент (client.wdl), и сервер (server.wdl). Один файл на обе стороны — это
// не экономия строк, а единственный способ не разойтись: формат, записанный
// дважды, расходится на первой же правке.
//
// Формат кадра (порядок байтов всюду big-endian, это умолчание):
//     kind     uint8     вид кадра: JOIN, SAY, LEAVE, INFO
//     size     int32     сколько байт в полезной части
//     payload  size байт строки подряд, каждая — int32 длины и байты в utf-8
//
// Длина впереди, а не разделитель в конце, потому что у TCP нет границ сообщений.
// Разделитель пришлось бы искать в каждом байте, а найдя — решать, что делать
// с тем же байтом внутри текста. Длина снимает оба вопроса разом и даёт накопителю
// ответ на главный: пришёл кадр целиком или ещё нет.

import sys.bytes as bin

// --- виды кадров -------------------------------------------------------------

const JOIN = 1          // вошёл: одна строка — имя
const SAY = 2           // сказал: две строки — имя и текст
const LEAVE = 3         // вышел: одна строка — имя
const INFO = 4          // сообщение сервера: одна строка — текст

// Заголовок одинаков у всех кадров, и потому накопитель умеет разобрать любой
// поток, не зная, что в нём: вид, длина, дальше по длине.
const HEADER = 5        // uint8 + int32

// Больше этого кадров не бывает. Длина приходит из сети, и доверять ей нельзя:
// без предела одно испорченное число заставило бы копить гигабайт в ожидании
// «остатка», которого не будет.
const MAX_FRAME = 64 * 1024

const EMPTY = bin.zeros(0)

// --- строки внутри кадра -----------------------------------------------------

// Длина строки — в байтах, а не в символах: "Аня" это три буквы и шесть байт,
// и читателю нужны байты.
def putText(w, value) {
    data = value.bytes
    w.putInt32(data.size).put(data)
    return w;
}

def takeText(r) => r.text(r.int32())

// --- сборка ------------------------------------------------------------------

def frame(kind, payload) =>
    bin.writer().putUint8(kind).putInt32(payload.size).put(payload).bytes

// Полезная часть — строки подряд. Их число задаёт вид кадра, и в самой части
// не записано: два способа узнать одно и то же — это два способа разойтись.
def pack(parts) {
    w = bin.writer()
    for (part in parts) putText(w, part)
    return w.bytes;
}

def join(nick) => frame(JOIN, pack([nick]))
def leave(nick) => frame(LEAVE, pack([nick]))
def info(text) => frame(INFO, pack([text]))
def say(nick, text) => frame(SAY, pack([nick, text]))

// --- разбор ------------------------------------------------------------------

// Кадр → сообщение: объект с полями по виду. Дальше по коду вид уже не разбирают
// байтами, только полем .kind.
//
// Строки читаются отдельными шагами, а не прямо в литерале объекта: порядок чтения
// здесь — часть формата, и полагаться на порядок вычисления полей в литерале
// значило бы спрятать его туда, где его не видно.
def decode(frame) {
    r = bin.reader(frame.payload)
    if (frame.kind == SAY) {
        nick = takeText(r)
        return {kind: SAY, nick: nick, text: takeText(r)};
    }
    if (frame.kind == JOIN || frame.kind == LEAVE) {
        return {kind: frame.kind, nick: takeText(r), text: ""};
    }
    if (frame.kind == INFO) {
        return {kind: INFO, nick: "", text: takeText(r)};
    }
    throw 'неизвестный вид кадра: ${frame.kind}';
}

// Сообщение → строка для окна. Показывают его обе стороны, поэтому и живёт оно
// здесь: два одинаковых форматирования разошлись бы так же, как два формата.
def line(message) => match (message.kind) {
    case JOIN  -> "* " + message.nick + " вошёл в чат"
    case LEAVE -> "* " + message.nick + " вышел"
    case INFO  -> "* " + message.text
    else       -> "[" + message.nick + "] " + message.text
}

// --- накопитель --------------------------------------------------------------

// То, ради чего модуль и нужен: из сокета приходят куски произвольной длины, а не
// кадры. Кадр может прийти двумя кусками, два кадра — одним, и хвост следующего
// кадра почти всегда приезжает вместе с концом предыдущего.
//
// У каждого соединения свой накопитель, и кормит его ровно один поток — слушатель
// этого сокета. Поэтому замок ему не нужен: общего состояния между соединениями
// тут нет вовсе (docs/threads.md).
class Framer(limit = MAX_FRAME) {

    def Framer() {
        // Остаток, которому не хватило до целого кадра. Поле заводится явно:
        // в заголовке ему не место — это внутреннее состояние, а не аргумент.
        this.rest = EMPTY
    }

    // Кусок из сокета → массив готовых кадров ({kind, payload, raw}), возможно пустой.
    def feed(chunk) {
        rest = rest + chunk
        ready = []
        while (rest.size >= HEADER) {
            r = bin.reader(rest)
            kind = r.uint8()
            size = r.int32()
            if (size < 0 || size > limit) {
                // Дальше читать нечего: поток рассинхронизирован, и следующая
                // длина будет взята из середины чужих данных. Честнее остановиться.
                throw 'кадр обещает ${size} байт — это не наш протокол';
            }
            if (rest.size < HEADER + size) {
                break       // кадр ещё едет; остаток ждёт следующего куска
            }
            ready.push({
                kind: kind,
                payload: rest.slice(HEADER, HEADER + size),
                // Кадр целиком: сервер пересылает его дальше как есть, не пересобирая.
                raw: rest.slice(0, HEADER + size)
            })
            rest = rest.slice(HEADER + size)
        }
        return ready;
    }
}
