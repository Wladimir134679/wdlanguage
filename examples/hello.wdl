// Первая настоящая программа на wdl: переменные и вывод.
//
// Запуск:  ./gradlew :wdl-cli:run --args="examples/hello.wdl"
//          wdl examples/hello.wdl
//          wdl --ast examples/hello.wdl   — посмотреть дерево программы

println("Привет, wdl!")

// --- переменные -------------------------------------------------------------
// Объявления нет: имя заводится первым присваиванием.

имя = "мир"
println("Привет, ", имя, "!")     // аргументы печатаются подряд, без разделителей

цена = 120
количество = 3
итого = цена * количество
println("Итого: ", итого, " руб.")

итого -= 60                        // составное присваивание
println("Со скидкой: ", итого, " руб.")

// Язык динамический: в одной переменной может побывать значение любого типа.
значение = 42
println(typeof(значение), ": ", значение)
значение = "теперь строка"
println(typeof(значение), ": ", значение)

// --- объекты и массивы ------------------------------------------------------
// Обращение через точку и по ключу в скобках — одна и та же операция.

товар = {имя: "болт", цена: 12, количество: 100}
println(товар.имя, " по ", товар["цена"], " руб., на складе ", товар.количество, " шт.")

товар.цена += 3                    // запись — то же обращение, что и чтение
println("Новая цена: ", товар.цена)

склад = [товар, {имя: "гайка", цена: 7, количество: 250}]
println("Позиций: ", len(склад), ", вторая — ", склад[1].имя)

стоимость = склад[0].цена * склад[0].количество + склад[1].цена * склад[1].количество
println("Стоимость склада: ", стоимость, " руб.")

// Ключ можно вычислить — поэтому отдельный синтаксис для «словарей» не нужен.
поле = "цена"
println("Цена гайки: ", склад[1][поле])

// --- функция это обычное значение -------------------------------------------
// println лежит в обычной переменной, поэтому его можно передать дальше.

напечатать = println
напечатать("И через другую переменную тоже.")

вывод = {строкой: println, отладка: print}
вывод.строкой("Даже когда функция лежит в поле объекта.")

// --- выражения --------------------------------------------------------------

println("2 + 2 * 2 = ", 2 + 2 * 2, ", а (2 + 2) * 2 = ", (2 + 2) * 2)
println("7 / 2 = ", 7 / 2, ", 6 / 3 = ", 6 / 3)
println("Маска: ", 0xF0 | 0b1111, ", сдвиг: ", 1 << 10)
println("Условие: ", итого > 100 ? "дорого" : "по карману")
println("Значение по умолчанию: ", товар.цвет || "цвет не указан")
