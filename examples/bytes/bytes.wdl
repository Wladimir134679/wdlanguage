// Байты: тип bytes и модуль sys.bytes
//
// Правило, вокруг которого построен файл, помещается в одну строку:
//   bytes — это данные, Writer — это то, где данные собирают.
// Отсюда всё остальное: bytes неизменяем, значит сравнивается по содержимому
// и безопасен в любом потоке; меняют же не его, а буфер.
//
// Правила языка — в docs/bytes.md.

import sys.bytes as bin

// --- откуда байты берутся ----------------------------------------------------

// Из текста — без всякого импорта: текст в языке уже есть.
hello = "привет".bytes                  // utf-8 по умолчанию
println(hello)                          // печать даёт длину и превью, а не мегабайт
println(hello.size, " байт на 6 букв")  // 12 — кириллица занимает по два

// Из шестнадцатеричной записи — так переписывают подпись формата из его описания.
png = bin.hex("89504e470d0a1a0a")
println(png)

// Из массива чисел, из base64, из нулей и из случайных байтов.
println(bin.of([0x89, 0x50, 0x4E, 0x47]) == png[0..3])   // true
println(bin.base64("iVBORw==") == png[0..3])             // true
println(bin.zeros(4), " ", bin.random(8).size)

// --- что можно спросить у готовых байтов -------------------------------------

// Всё это — члены типа, импорта они не требуют.
println(png.size, " ", png.empty, " ", png.hex)
println(png.base64)
println(png.numbers)                    // [-119, 80, 78, 71, 13, 10, 26, 10]

// Обращение — те же правила, что у массива и строки: отрицательный индекс от конца,
// срез включительный и подрезается.
println(png[0], " ", png[-1], " ", png[1..3])

// Обход даёт байты числами.
sum = 0
for (b in png) { sum += b }
println("сумма байтов: ", sum)

// --- байт наружу выходит знаковым --------------------------------------------

// Это главное, что стоит запомнить, и единственное, чем bytes удивляет.
// Подпись PNG в описании формата записана как 89 50 4e 47 — беззнаково.
// А b[i] отдаёт знаковое число, как в Java:
println(png[0])                         // -119, а не 137
println(png.uint8(0))                   // 137 — беззнаковый ответ просят по имени

// Поэтому подпись сравнивают не побайтно, а целиком — так и читается лучше:
println(png.startsWith(bin.hex("89504e47")))   // true

// --- сравнение по содержимому ------------------------------------------------

// Именно ради этой строки bytes сделан неизменяемым. У массива, который можно
// поменять, сравнение идёт по ссылке, и здесь была бы ложь.
println(bin.hex("abcd") == bin.hex("abcd"))    // true
println([1, 2] == [1, 2])                      // false — массивы сравниваются по ссылке

// Склейка — обычный '+', как у строк и массивов.
println(bin.hex("ab") + bin.hex("cd"))

// Поиск: и отдельный байт, и целая последовательность.
println(0x50 in png, " ", bin.hex("0d0a") in png, " ", png.indexOf(bin.hex("0d0a")))

// --- что собирают буфером ----------------------------------------------------

// Всё, что выше, — только чтение: записать в bytes нельзя вовсе.
// png[0] = 1                           // ошибка: bytes неизменяем, для записи есть Writer

w = bin.writer()
w.order("le")                           // младший байт первым; "be" — умолчание
w.putInt32(42)
w.putText("ok")
w.put(png)                              // целые байты
w.put(255)                              // один байт: 255 и -1 — две записи одного
packet = w.bytes                        // снимок; в w можно писать дальше

println(packet.size, " ", packet.hex)

// Строгие put проверяют именно свой диапазон — их для этого и пишут.
println(try? bin.writer().putInt8(200))     // null: int8 это -128..127
println(bin.writer().putUint8(200).bytes)   // а uint8 — 0..255

// Буфер на n байтов и ни байтом больше: переполнение — ошибка, а не тихий рост.
small = bin.fixed(2)
small.put(1).put(2)
println(small.bytes, " ", try? small.put(3))

// --- и что разбирают курсором ------------------------------------------------

// То же, что packet.int32(0), packet.text(4, 2), … — только смещение считает он сам.
r = bin.reader(packet)
r.order("le")
println(r.int32())                      // 42
println(r.text(2))                      // ok
println(r.bytes(8).hex)                 // подпись png
println(r.uint8(), " осталось: ", r.remaining, " конец: ", r.done)

// Конец данных — ошибка, а не правдоподобный мусор: обрезанный файл лучше
// заметить здесь, чем разобрать по нему половину формата.
println(try? bin.reader(bin.hex("0102")).int32())      // null

// --- текст и байты -----------------------------------------------------------

println("привет".bytes.text())                          // привет
println("привет".encode("cp1251").size)                 // 6 — другая кодировка, явно
println("привет".encode("cp1251").text("cp1251"))       // привет

// Испорченная последовательность — ошибка, а не подмена вопросиками: молчаливая
// замена превращает битые данные в правдоподобный текст.
println(try? bin.hex("c8").text())                      // null
println(bin.hex("c8").text("utf-8", true))              // а вот так — осознанно

// --- девять видов числа, один словарь ----------------------------------------

// Эти же девять слов стоят суффиксом члена, именем put-метода и именем метода
// курсора: int8, uint8, int16, uint16, int32, uint32, int64, float32, float64.
number = bin.writer().putFloat64(3.5).bytes
println(number.hex, " ", number.float64(0))

// Порядок байтов — два слова везде: "be" (умолчание) и "le".
println(bin.hex("0000002a").int32(0), " ", bin.hex("0000002a").int32(0, "le"))
