// Именованные аргументы: f(name: value).
// Запуск: wdl examples/named-args.wdl

def greet(name, greeting = "привет", punct = "!") => greeting + ", " + name + punct

// Как раньше — по позиции
println(greet("мир"))

// Пропуск в середине: ради этого всё и затевалось
println(greet("мир", punct: "?"))

// Порядок свободный, если все аргументы названы
println(greet(greeting: "здравствуй", name: "мир"))

// --- позиционные идут первыми ------------------------------------------------

// greet(greeting: "эй", "мир")
// ошибка разбора: после именованного аргумента позиционному негде взять позицию

// --- значения по умолчанию считаются как обычно ------------------------------

def total(price, count = 1, tax = price * count * 0.2) => price * count + tax

// count пропущен и вычисляется, tax передан по имени
println("итого: ", total(100, tax: 0))
// значение по умолчанию по-прежнему видит параметры слева
println("итого: ", total(price: 100, count: 2))

// --- классы: те же скобки, то же правило -------------------------------------

class Point(x, y = 0) {
    def text() => "(" + x + ", " + y + ")"
}

println("точка: ", new Point(y: 3, x: 1).text())

// Заголовок родителя — тот же список аргументов, поэтому имена работают и там.
// Опечатка в имени поймается на объявлении класса, а не при первом создании.
class Shape(kind, title = "фигура") {
    def text() => title + ": " + kind
}
class Circle(r) : Shape(kind: "round", title: "круг") {
    def area() => 3.14 * r * r
}

println("фигура: ", new Circle(5).text())

// --- порядок вычисления — по тексту, а не по параметрам ----------------------

def mark(what) {
    print("вычисляю ", what, " ")
    return what;
}
def join(a, b) => a + b

// сначала b, потом a — так, как написано
println(join(b: mark("b"), a: mark("a")))

// --- встроенные функции ------------------------------------------------------

// Имена есть у тех встроенных, которые их объявили: например, у sys.gui.
// println имён не имеет и не может иметь — он принимает сколько угодно аргументов,
// и вызов по имени скажет об этом прямо:
// println(value: 1)   // ошибка: принимает аргументы только по позиции
println("готово")
