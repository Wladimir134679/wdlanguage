// Ожидаемая остановка: слишком глубокая рекурсия.
//
// Это FatalError, а не ошибка скрипта, и разница здесь принципиальная: обработчик
// вокруг стоит, но не срабатывает. Проверить такое обычным набором тестов нельзя
// по построению — тест, который «поймал» остановку выполнения, тем самым доказал бы
// обратное. Поэтому случай вынесен в отдельный файл, который обязан падать.
//
// finally при этом выполняется: закрыть начатое на пути наружу можно и нужно,
// а вот подавить причину — нет.

fun forever(n) => forever(n + 1)

try {
    try {
        forever(0)
    } catch (e) {
        println("сюда выполнение не дойдёт: catch остановку не видит")
    }
} finally {
    println("а finally выполняется — эту строку видно в выводе")
}

println("и сюда не дойдёт тоже")
