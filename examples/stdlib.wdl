// Стандартная библиотека: функции и классы, написанные на Java и подкинутые
// в область видимости. Как это устроено — в docs/embedding.md.
//
// Для скрипта разницы нет никакой: File — такой же класс, как объявленный
// через 'class', с полями, методами, фабрикой и проверкой 'is'.

// --- функции -----------------------------------------------------------------

println(pow(2, 10))                 // 1024 — целое осталось целым
println(pow(2, 0.5))                // 1.4142135623730951
println(sqrt(16), " ", abs(-7))     // 4.0 7

// --- класс File: путь это поле, а не метод -----------------------------------

f = new File("build/пример.txt")

println(typeof(f), " ", f is File)  // object true
println(f.path)                     // build/пример.txt — обычное поле
println(f)                          // File{"path": "build/пример.txt"}

// Методы возвращают сам файл, поэтому их можно выстроить в цепочку
f.write("первая строка\n").append("вторая строка\n")

println(f.exists(), " ", f.size())
println(f.read())
println("строк: ", len(f.lines()), ", вторая — ", f.lines()[1])
println(f.name())

// Поле — обычное значение, и его можно перебрать, как у любого объекта
for (key in f) println("  ", key, " = ", f[key])

// --- фабрика и поле класса ---------------------------------------------------

temp = File.temp("wdl-demo")        // способ создания с именем
println(temp.exists(), " ", temp.size())
temp.remove()
println(temp.exists())

println("разделитель пути: ", File.SEPARATOR)

// --- класс Random: состояние, которого в языке нет ---------------------------

// Зерно — обычное поле, а сам генератор значением языка не выражается
// и живёт в состоянии экземпляра
r = new Random(42)
println(r.seed)                     // 42
println(r.int(100), " ", r.int(100), " ", r.int(100))

// Одно зерно — одна последовательность: два генератора дают одно и то же
a = new Random(1)
b = new Random(1)
println(a.int(1000) == b.int(1000))     // true

println(new Random(7).pick(["болт", "гайка", "шайба"]))

// --- встроенный класс — обычное значение -------------------------------------

def describe(cls, path) => new cls(path).name()
println(describe(File, "каталог/файл.txt"))

kinds = [File]
println(new kinds[0]("ещё.txt").path)

// Уберём за собой
f.remove()
