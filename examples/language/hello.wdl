// Первая настоящая программа на wdl: переменные и вывод.
//
// Запуск:  ./gradlew :wdl-cli:run --args="examples/language/hello.wdl"
//          wdl examples/language/hello.wdl
//          wdl --ast examples/language/hello.wdl   — посмотреть дерево программы

println("Привет, wdl!")

// --- переменные -------------------------------------------------------------
// Объявлять переменную не нужно: имя заводится первым присваиванием. Объявление
// в языке одно — const, имя, которое нельзя перезаписать: examples/language/const.wdl

name = "мир"
println("Привет, ", name, "!")     // аргументы печатаются подряд, без разделителей

price = 120
count = 3
total = price * count
println("Итого: ", total, " руб.")

total -= 60                        // составное присваивание
println("Со скидкой: ", total, " руб.")

// Язык динамический: в одной переменной может побывать значение любого типа.
value = 42
println(typeof(value), ": ", value)
value = "теперь строка"
println(typeof(value), ": ", value)

// --- объекты и массивы ------------------------------------------------------
// Обращение через точку и по ключу в скобках — одна и та же операция.

item = {name: "болт", price: 12, count: 100}
println(item.name, " по ", item["price"], " руб., на складе ", item.count, " шт.")

item.price += 3                    // запись — то же обращение, что и чтение
println("Новая цена: ", item.price)

stock = [item, {name: "гайка", price: 7, count: 250}]
println("Позиций: ", len(stock), ", вторая — ", stock[1].name)

worth = stock[0].price * stock[0].count + stock[1].price * stock[1].count
println("Стоимость склада: ", worth, " руб.")

// Ключ можно вычислить — поэтому отдельный синтаксис для «словарей» не нужен.
field = "price"
println("Цена гайки: ", stock[1][field])

// --- функция это обычное значение -------------------------------------------
// println лежит в обычной переменной, поэтому его можно передать дальше.

show = println
show("И через другую переменную тоже.")

output = {line: println, raw: print}
output.line("Даже когда функция лежит в поле объекта.")

// --- выражения --------------------------------------------------------------

println("2 + 2 * 2 = ", 2 + 2 * 2, ", а (2 + 2) * 2 = ", (2 + 2) * 2)
println("7 / 2 = ", 7 / 2, ", 6 / 3 = ", 6 / 3)
println("Маска: ", 0xF0 | 0b1111, ", сдвиг: ", 1 << 10)
println("Условие: ", total > 100 ? "дорого" : "по карману")
println("Значение по умолчанию: ", item.color || "цвет не указан")
