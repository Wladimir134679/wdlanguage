// Срез и отрицательный индекс. Запуск: wdl examples/language/slices.wdl
//
// Два правила, которые живут в одной точке языка — в квадратных скобках:
// отрицательное число считается от конца, диапазон вместо числа даёт срез.
// Ключ по-прежнему один на все типы, просто контейнер толкует его по-своему.

items = [10, 20, 30, 40, 50]

// --- отрицательный индекс: позиция с конца ---------------------------------------

println(items[-1])          // 50 — последний
println(items[-2])          // 40 — предпоследний

// Читается и пишется одинаково: иначе '-1' значило бы разное слева и справа от '='
items[-1] = 55
println(items)              // [10, 20, 30, 40, 55]

// --- срез: диапазон вместо числа --------------------------------------------------

// Границы включительны с обеих сторон — как у 'for (i in 1..3)' и у '3 in 1..3'.
// Это сознательно расходится со 'slice(from, to)', где конец не входит:
// '..' в языке включителен везде, и ломать это ради одного метода нельзя.
println(items[1..3])        // [20, 30, 40] — три элемента
println(items.slice(1, 3))  // [20, 30]     — два, конец не входит

// Тип результата не зависит от значений границ: срез из одного — всё равно массив
println(items[0..0])        // [10]

// Ради чего это и затевалось
println(items[1..-1])       // [20, 30, 40, 55] — от второго до последнего
println(items[-2..-1])      // [40, 55]         — последние два

// --- две дисциплины индекса --------------------------------------------------------

// Элемент спрашивает «какой под этим номером» — ответа нет, значит ошибка.
// Срез спрашивает «какая часть попадает в промежуток» — ответ есть всегда,
// иногда пустой. Поэтому границы среза подрезаются, а не ошибаются.
println(items[3..100])      // [40, 55] — верх подрезан
println(items[-100..1])     // [10, 20] — низ подрезан
println(items[4..2])        // []       — пустой диапазон, пустой срез
println(items[0..-1])       // весь массив: '-1' — это последний, а не «пусто»

// --- срез — копия, а не вид --------------------------------------------------------

part = items[0..1]
part[0] = 0
println(part, " ", items[0])   // [0, 20] 10 — исходный не тронут

// --- строка ведёт себя так же и отдаёт строку ---------------------------------------

name = "wdlanguage"
println(name[0])            // w
println(name[-1])           // e
println(name[0..2])         // wdl
println(name[-4..-1])       // uage

// Меряется всё в кодовых единицах UTF-16 — как 'len', как 's[i]', как позиции
// в сообщениях об ошибках. Срез посередине суррогатной пары даёт половину пары.

// --- то же правило у членов с позицией ------------------------------------------------

// «Число значит позицию» обязано значить одно и то же везде, иначе член
// и обращение по индексу разошлись бы поведением, а не только текстом
println(items.slice(-2))    // [40, 55] — последние два
items.insert(-1, 45)
println(items)              // [10, 20, 30, 40, 45, 55]
println(items.remove(-1))   // 55
println(items)              // [10, 20, 30, 40, 45]

// --- у объекта диапазон остаётся ключом -------------------------------------------------

// Это не исключение из правила, а само правило: у массива ключ — позиция,
// у объекта — ключ, а диапазон в объекте лежит наравне со строкой и числом
schedule = {}
schedule[9..12] = "morning"
schedule[13..18] = "afternoon"
println(schedule[9..12])    // morning
println(schedule)           // {9..12: "morning", 13..18: "afternoon"}

// --- что здесь ошибка -------------------------------------------------------------------

// println(items[9])          // индекс 9 вне границ массива размером 5
// println(items[-9])         // ...размером 5: отрицательный индекс считается от конца, наименьший здесь -5
// println(items[1.5])        // индекс массива должен быть целым числом
// println(items[0.5..2.5])   // границы среза массива должны быть целыми числами
// items[1..3] = [0, 0, 0]    // в срез нельзя записать: это заменило бы часть массива вместе с его длиной
// name[1..3] = "xyz"         // строку нельзя изменить по индексу или срезу: строки неизменяемы
// println(items[..3])        // открытых границ нет: '..' — бинарный оператор, и вместо 'items[1..]' пишется 'items[1..-1]'
