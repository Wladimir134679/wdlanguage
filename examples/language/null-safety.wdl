// Безопасное обращение '?.' и подстановка '??'.
// Конфиг и разобранный JSON — это дерево с дырами, и каждая дыра раньше стоила
// отдельной проверки. Здесь показано, как она пишется одним знаком.

config = {
    db: { host: "db.local", port: 5432 },
    cache: null
}

// --- ради чего всё -------------------------------------------------------

// Пусто в любом месте пути — значение всей цепочки пусто, и '??' подставляет своё.
println(config?.db?.host ?? "localhost")        // db.local
println(config?.cache?.host ?? "localhost")     // localhost — ключ есть, значение пусто
println(config?.queue?.host ?? "localhost")     // localhost — ключа нет вовсе

// --- замыкание идёт до конца цепочки -------------------------------------

// '?.' достаточно написать там, где пусто бывает: дальше цепочка уже пропущена
// целиком, и '.name' не выполняется.
user = null
println(user?.profile.name)                     // null

// Скобки закрывают цепочку раньше — дальше обращение идёт по её значению,
// и пустота перестаёт быть безопасной:
// println((user?.profile).name)                // ошибка: к значению типа null нельзя обратиться через точку ('.name')

// --- вызов ---------------------------------------------------------------

// Метода в языке нет: 'logger.info(...)' — это обращение и вызов его результата.
// Поэтому '?.' закрывает и вызов тоже.
logger = null
logger?.info("запуск")                          // ничего не произошло

handlers = { onClick: null }
println(handlers.onClick?.())                   // null, а не «вызвать можно только функцию»

// Аргументы пропущенного вызова не вычисляются.
def track(name) {
    println("считали " + name)
    return name;
}
missing = null
missing?.send(track("груз"))                    // 'track' не звали

// --- ключ в скобках ------------------------------------------------------

response = { data: [{ title: "первая" }] }
println(response?.data?.[0]?.title ?? "без заголовка")   // первая
println(response?.rows?.[0]?.title ?? "без заголовка")   // без заголовка

// --- '??' против '||' ----------------------------------------------------

// Ложны в языке двое — null и false, — а пусто только одно. Вся разница поэтому
// в выключённом признаке: '??' его сохраняет, '||' подменяет.
settings = { verbose: false }
println(settings.verbose ?? true)               // false — значение задано, оно и остаётся
println(settings.verbose || true)               // true  — ложь подменена
println(settings.quiet ?? true)                 // true  — ключа нет, значит пусто

// Ноль и пустая строка здесь истинны, и их не подменяет ни та, ни другая запись.
println(0 ?? 8080)                              // 0
println(0 || 8080)                              // 0

// Правая часть вычисляется только при нужде.
def fallback() {
    println("искали запасное")
    return "запасное";
}
println("основное" ?? fallback())               // основное, без строки про поиск

// --- сила связывания -----------------------------------------------------

// '??' сильнее сравнений: сравнивается ответ подстановки.
name = null
println(name ?? "аноним" == "аноним")           // true
// и слабее арифметики: правая часть забирает её себе.
price = null
println(price ?? 0 + 5)                         // 5  — это 'price ?? (0 + 5)'
println((price ?? 0) + 5)                       // 5  — а так считается то, что написано

// --- запись по нужде -----------------------------------------------------

options = { retries: 0 }
options.retries ??= 3                           // не пусто — не пишем вовсе
options.timeout ??= 30                          // ключа не было — записали
println(options)                                // {"retries": 0, "timeout": 30}

// Имя должно существовать — мерка та же, что у '+=':
// host ??= "localhost"                         // ошибка: переменная 'host' не определена
host = null
host ??= "localhost"
println(host)                                   // localhost

// --- чего '?.' не делает -------------------------------------------------

// Закрывает он ровно один случай — пустого получателя. Всё остальное остаётся
// ошибкой, какой и было:
items = [1, 2]
// println(items?.[9])                          // ошибка: индекс 9 вне границ массива размером 2
// println("abc"?.nosuch)                       // ошибка: у значения типа строка нет члена 'nosuch'

// Слева от присваивания безопасного обращения не бывает: запись в пустое
// значение молча потеряла бы данные.
// config?.db = {}                              // ошибка: '?.' не может стоять слева от '='

// Ошибку ловит не он, а 'try?' — два разных знака вопроса про разные беды.
println(try? items[9] ?? "промах")              // промах
