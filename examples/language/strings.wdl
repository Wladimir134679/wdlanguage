// Строки: экраны, многострочный литерал и снятие отступа.
//
// Запуск:  ./gradlew :wdl-cli:run --args="examples/language/strings.wdl"

// --- обычная строка ---------------------------------------------------------

greeting = "Привет, wdl!"
println(greeting)
println("Перевод\nстроки, табуляция\tи кавычка \"внутри\"")

// --- многострочная строка ---------------------------------------------------
// Открывается тремя кавычками и переводом строки, закрывается тремя кавычками.
// Отступ в исходнике в значение не попадает: левый край текста задают
// закрывающие кавычки.

letter = """
    Дорогой друг,
    это письмо набрано с отступом,
    но в значении отступа нет.
    """
print(letter)

// Сдвинем закрывающие кавычки влево — и часть отступа останется в тексте.

shifted = """
    сдвинуто на два пробела
  """
print(shifted)

// Внутренняя вложенность сохраняется — снимается только общий отступ.

config = """
    server:
      host: localhost
      port: 8080
    """
print(config)

// Кавычки внутри блока экранировать не нужно, пока их не три подряд.

quote = """
    Он сказал: "готово" — и закрыл ноутбук.
    """
print(quote)

// --- escape внутри блока ----------------------------------------------------
// Escape-последовательности разворачиваются последними, уже после снятия отступа:
// написанный \\n на деление строк не влияет.

joined = """
    Эта строка длинная, поэтому в исходнике она \
    разбита пополам, а в значении осталась одной.
    """
print(joined)

// Хвостовые пробелы срезаются в каждой строке. Нужный пробел на краю пишется \\s.

padded = """
    край  \s"""
println("[", padded, "]")

// Блок — обычная строка: те же члены и те же операции.

println("строк в письме: ", len(letter.split("\n")) - 1)
println("тип: ", typeof(letter))

// --- строка с подстановкой --------------------------------------------------
// Одинарные кавычки — та же строка, но со вставками ${...}. В двойных кавычках
// подстановки нет: правило «в двойных всё буквально» видно по самой кавычке.

name = "мир"
price = 120
count = 3

println('Привет, ${name}!')
println('итого: ${price * count} руб.')

// Внутри подстановки — обычное выражение: вызов, условие, объект, другая строка.

def discount(sum) => sum > 300 ? sum - 60 : sum

println('со скидкой: ${discount(price * count)} руб.')
println('дорого? ${price * count > 300 ? "да" : "нет"}')
println('поле объекта: ${ {city: "Москва"}.city }')
println('строка в строке: ${ 'привет, ${name}' }')

// Значение вставляется тем же представлением, каким его печатает println.

println('${null} ${[1, 2]} ${ {a: 1} }')

// Строка без подстановки — обычный литерал, поэтому годится и там, где нужен
// именно он: ключом объекта, путём импорта.

prices = {'болт': 12, 'гайка': 7}
println('болт стоит ${prices['болт']} руб.')

// Буквальный доллар со скобкой пишется через обратную косую.

println('шаблон: \${name}')

// --- многострочная строка с подстановкой ------------------------------------
// Три одинарные кавычки: правила просто складываются — отступ снимается как
// у """, подстановки работают как у одинарных кавычек.

items = ["болт", "гайка"]

report = '''
    Отчёт для ${name}
      позиций: ${items.size}
      итого:   ${price * count} руб.
    '''
print(report)

// Подстановка в начале строки текст не сдвигает: отступ мерят строки,
// которые в блоке начались.

summary = '''
    ${items[0]} — первый
      ${items[1]} — второй, с отступом
    '''
print(summary)

// А сама подстановка может занимать несколько строк: перевод строки внутри
// неё блок не обрывает.

total = '''
    итого: ${
        price * count
    } руб.
    '''
print(total)
