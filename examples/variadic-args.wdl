// Вариативные параметры и раскрытие: *args, **named, f(*array), f(**object).
// Запуск: wdl examples/variadic-args.wdl

def inspect(a, b = 10, *args, **named) {
    println("a = ", a, ", b = ", b, ", args = ", args, ", named = ", named)
}

// Лишние позиционные уходят в args, незнакомые имена — в named
inspect(1, 2, 3, 4, mode: "fast")

// Остаток пуст, если остатка нет: b берёт своё значение по умолчанию
inspect(1)
inspect(1, 2)

// Известное имя всегда достаётся обычному параметру, а не остатку
inspect(1, b: 2, mode: "fast")

// --- раскрытие контейнеров ---------------------------------------------------

def target(a, b, defC = 10) => println(a, " ", b, " ", defC)

values = [1, 2]
options = {defC: 3}

target(*values)                    // 1 2 10 — defC считает своё значение по умолчанию
target(*values, **options)         // 1 2 3
target(*[1], b: 2)                 // позиционная группа идёт первой, имена — следом

// Раскрыть можно и во встроенную функцию: имён у неё нет, а число аргументов есть
println(*["раскрытие", " ", "в println"])

// --- прозрачный проброс ------------------------------------------------------

// Обёртка не знает ни числа аргументов, ни их имён — и не должна
def proxy(fun, *args, **named) => fun(*args, **named)

proxy(target, *[1, 2], **{defC: 3})

def logged(fun) => def(*args, **named) {
    println("вызов с ", args, " и ", named)
    return fun(*args, **named);
}

loud = logged(target)
loud(7, 8)
loud(7, 8, defC: 9)

// --- что не работает ---------------------------------------------------------

// target(defC: 3, *values)     // ошибка разбора: раскрытие массива после имени
// target(*values, **{a: 5})    // ошибка выполнения: 'a' задан и позиционно, и по имени
// target(*"строка")            // ошибка выполнения: раскрыть можно только массив
// def bad(*args, value) {}     // ошибка разбора: обычный параметр после остатка

// --- классы: раскрытие есть, остатка в заголовке нет -------------------------

class Point(x, y) {
    def show() => println("(", this.x, ", ", this.y, ")")
}

coords = [3, 4]
new Point(*coords).show()
new Point(**{x: 5, y: 6}).show()
