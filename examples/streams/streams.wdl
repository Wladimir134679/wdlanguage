// Ленивые конвейеры: sys.streams
//
// Правило, вокруг которого построен файл: массив отвечает на «преобразуй эти данные»,
// поток — на «протяни данные через конвейер, не собирая их». Всё, что здесь показано,
// массивом либо не делается вовсе, либо делается дороже.
//
// Правила языка — в docs/streams.md.

import sys.streams as streams
import sys.thread as th
import sys.io as io

// --- ничего не происходит, пока не спросили ----------------------------------

// Промежуточные операции работы не делают: они надстраивают звено. Счётчик это
// и показывает — после сборки конвейера он нулевой.
calls = th.counter()
def heavy(x) {
    calls.inc()
    return x * x;
}

pipeline = streams.range(1, 1000000).map(heavy)
println("собрали конвейер, вызовов heavy: ", calls.get())    // 0

// Терминальная операция тянет ровно столько, сколько нужно для ответа.
println("первый: ", pipeline.first(), ", вызовов heavy: ", calls.get())     // 1 1

// Короткое замыкание сквозь стадии — то, чего у массива нет: 'a.map(heavy).find(p)'
// посчитал бы heavy для всех миллиона элементов.
calls.set(0)
found = streams.range(1, 1000000).map(heavy).find(v => v > 50)
println("первый квадрат больше 50: ", found, ", вызовов heavy: ", calls.get())   // 64 8

// --- источники ---------------------------------------------------------------

println("диапазон: ", streams.range(1, 5).list())
println("склейка:  ", streams.concat(streams.range(1, 2), [9, 10]).list())
println("повтор:   ", streams.repeat("-").limit(10).join(""))
println("пустой:   ", streams.empty().count())

// Бесконечная последовательность кончается там, где кончился интерес к ней.
println("степени двойки: ", streams.iterate(1, x => x * 2).limit(8).list())
println("первая больше 500: ", streams.iterate(1, x => x * 2).find(x => x > 500))

// Член массива появляется вместе с import sys.streams — без него его нет.
prices = [50, 120, 300, 80]
println("дорогие вдвое: ", prices.stream().filter(p => p >= 100).map(p => p * 2).list())

// --- поток одноразовый -------------------------------------------------------

// И промежуточная операция расходует его наравне с терминальной.
once = streams.of([1, 2, 3])
println("сумма: ", once.sum())
// once.count()          // ошибка: поток уже пройден — он читается один раз

// --- поток как ресурс --------------------------------------------------------

// Путь считается от текущего каталога процесса, а не от каталога скрипта, поэтому
// каталог создаётся здесь же: пример запускают и из корня репозитория, и из своей папки.
log = io.mkdirs("build") + io.SEPARATOR + "streams-example.log"
io.write(log, "GET / 200\nGET /a 500\nGET /b 200\nGET /c 500\n")

// use закрывает поток на выходе, что бы ни случилось внутри. Файл при этом читается
// лениво: find останавливается на первой подходящей строке.
use (s = streams.lines(log)) {
    println("первая пятисотка: ", s.find(l => l.contains(" 500")))
}

// Терминальная операция закрывает конвейер и сама: дескриптор не остаётся висеть.
println("всего пятисоток: ", streams.lines(log).filter(l => l.contains(" 500")).count())

// --- составные операции ------------------------------------------------------

println("пары:   ", streams.of([1, 2, 3]).zip(streams.of(["a", "b"])).list())
println("куски:  ", streams.range(1, 5).chunked(2).list())
println("окна:   ", streams.range(1, 4).windowed(3).list())
println("без повторов: ", streams.of([1, 2, 1, 3, 2]).distinct().list())

// Аргумент sorted — ключ сравнения, а не компаратор. Считается он один раз
// на элемент, а не на каждое сравнение.
println("по длине: ", streams.of(["aaa", "b", "cc"]).sorted(w => len(w)).list())

// sorted — барьер: читает вход целиком. На бесконечном источнике он не кончится
// никогда, и это свойство операции, а не дефект.
// streams.repeat(1).sorted().first()        // повиснет

// distinct барьером не является: ему довольно помнить выданное.
println("цикл из трёх: ", streams.iterate(1, x => (x + 1) % 3).distinct().limit(3).list())

// --- терминальные операции ---------------------------------------------------

// Ответы у пустого потока — те же, что у пустого массива.
println("пусто: ", streams.empty().count(), " ", streams.empty().sum(), " ",
        streams.empty().first(), " ", streams.empty().all(), " ", streams.empty().any())

println("свёртка: ", streams.range(1, 5).reduce(def (total, x) => total + x))
println("в объект: ", streams.of(["ann", "bob"]).object(n => n, n => len(n)))

// each отдаёт число пройденных, а не сам поток: поток пройден, и возвращать его
// значило бы отдать значение, любое действие над которым — ошибка.
seen = streams.range(1, 3).each(x => print(x, " "))
println("— обошли ", seen)

// --- канал вместо генератора -------------------------------------------------

// Отдельного yield в языке нет: продюсер в своём потоке пишет в канал, конвейер
// читает. Закрыть канал обязательно — иначе читатель не узнает, что работа кончилась.
ch = th.channel()
producer = th.spawn("producer", def () {
    for (i in 1..5) { ch.send(i * i) }
    ch.close()
})
println("из канала: ", streams.of(ch).list())
producer.join()

// --- конкурентная обработка --------------------------------------------------

// Четыре задачи сразу вместо четырёх подряд. Порядок результатов — порядок входа,
// а не порядок завершения: первая задача здесь самая медленная.
println("конкурентно: ", streams.range(0, 5).mapConcurrent(4, def (x) {
    th.sleep((5 - x) * 20)
    return x * 10;
}).list())

// Ошибка задачи остаётся ошибкой языка: с классом, местом и обычным catch.
try {
    streams.range(1, 4).mapConcurrent(2, i => [10, 20][i]).list()
} catch (e is IndexError) {
    println("поймали: ", e.message)
}

io.remove(log)
