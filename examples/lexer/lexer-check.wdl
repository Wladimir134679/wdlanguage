// Проверка лексера: здесь встречается каждая конструкция, которую он умеет разбирать.
// Запуск:  ./gradlew :wdl-cli:run --args="examples/lexer/lexer-check.wdl"
//          wdl --tokens examples/lexer/lexer-check.wdl

/* Блочный комментарий.
   Он занимает несколько строк и на разбор не влияет:
   перевод строки в этом языке — такой же пробел, как остальные. */

import logger as log

// --- числа -----------------------------------------------------------------
целое      = 42
сСтроками  = 1_000_000        // разделители разрядов выкидываются лексером
дробное    = 63.2
экспонента = 6.02e23
малое      = 1.6e-19
шестнадцат = 0xDEAD_BEEF
двоичное   = 0b1010_0101

// Точка после числа не съедается — иначе не было бы обращения к методу.
округлённое = 3.75.round()

// --- строки ------------------------------------------------------------------
привет   = "Привет, мир!"
экраны   = "строка\nс переносом\tи табуляцией"
кавычки  = "он сказал: \"да\" — и ушёл"
юникод   = "Знак: ✓"
пустая   = ""

// --- логика и сравнения --------------------------------------------------------
флаг = true && !false || null == null
сравн = (целое >= 40) != (дробное < 10)

// --- биты -----------------------------------------------------------------------
маска = (0xFF & 0x0F) | (1 << 4) ^ ~0
сдвиг = -16 >> 2
беззнак = -16 >>> 2

// --- присваивания ---------------------------------------------------------------
счётчик = 0
счётчик += 5
счётчик -= 1
счётчик *= 2
счётчик /= 4
счётчик %= 3
счётчик <<= 1
счётчик >>= 1
счётчик >>>= 1
счётчик &= 0xF
счётчик |= 0b1
счётчик ^= 2
счётчик++
счётчик--

// --- константы -------------------------------------------------------------------
const LIMIT = 10

// --- функции ---------------------------------------------------------------------
def сумма(a, b) {
    return a + b
}

// Тело без фигурных скобок. Обе записи дают ровно один и тот же поток токенов:
// перенос строки ничем не отличается от пробела.
def однойСтрокой(a, b)
    return a * b

def однойСтрокой2(a, b) return a * b

анонимная = def(a, b) {
    return a - b
}

// По той же причине вызов свободно переносится на несколько строк.
println(
    "сумма = ", сумма(1, 2),
    " произведение = ", однойСтрокой(3, 4),
    " разность = ", анонимная(9, 4)
)

// --- ветвления и циклы ------------------------------------------------------------
if счётчик > 10 {
    println("много")
} else if счётчик > 0 {
    println("немного")
} else {
    println("ничего")
}

for (i = 0; i < 3; i++) {
    if i == 1 { continue }
    if i == 9 { break }
    println("i = " + i)
}

do {
    счётчик--
} while (счётчик > 0)

while (false) { }

// --- коллекции и доступ по индексу ---------------------------------------------------
массив = [1, 2, 3, "четыре", [5, 6]]
объект = {"ключ": "значение", "число": 7}
элемент = массив[0] + массив[4][1]

// --- match ---------------------------------------------------------------------------
результат = match целое {
    case 0 -> "ноль"
    case 42 -> "ответ"
    case _ -> "другое"
}

// --- классы ---------------------------------------------------------------------------
class Точка {

    def Точка(x = 0, y = 0) {
        this.x = x
        this.y = y
    }

    def сдвинуть(dx, dy) {
        this.x += dx
        this.y += dy
    }

    def строкой() = "(" + this.x + ", " + this.y + ")"
}

точка = new Точка(20, 30)
точка.сдвинуть(10, -5)
println(точка.строкой())

// Точка с запятой — необязательный разделитель: нужна там, где инструкции стоят
// в одной строке, и в заголовке for.
a = 1; b = 2; println(a + b);

log.info("Проверка лексера завершена")
