// Наследование: один родитель, super, виртуальные вызовы, полиморфизм.
// Основы классов — в examples/classes.wdl, трейты — в examples/traits.wdl.
// Описание правил — в docs/classes.md.

// --- родитель и потомок ------------------------------------------------------

// Аргументы родителю пишутся прямо в заголовке: ': Shape("круг")'. Так видно,
// что потомок передаёт наверх, и проверить это можно, не выполняя конструктор.
class Shape(kind) {
    def area() => 0
    def text() => kind + " площадью " + area()      // area() ≡ this.area()
}

class Circle(radius) : Shape("круг") {
    def area() => 3.14159 * radius * radius
}

c = new Circle(5)
println(c.text())                   // круг площадью 78.53975
println(c.kind, " ", c.radius)      // круг 5 — поле досталось от родителя

// --- виртуальность: родитель зовёт реализацию потомка -------------------------

// text() написан в Shape и зовёт area(). Внутри метода голое имя ищется
// в классе экземпляра, поэтому у круга находится его собственная площадь.
class Square(side) : Shape("квадрат") {
    def area() => side * side
}

println(new Square(4).text())       // квадрат площадью 16

// --- super: точка отсчёта, а не другой объект --------------------------------

class Ring(radius, hole) : Circle(radius) {

    def area() => super.area() - 3.14159 * hole * hole
    def text() => super.text() + " (с отверстием " + hole + ")"
}

r = new Ring(5, 2)
println(r.text())                   // круг площадью 65.97339 (с отверстием 2)

// super — тот же самый объект, просто поиск метода начинается с родителя
println(r is Ring, " ", r is Circle, " ", r is Shape)   // true true true

// --- цепочка из трёх уровней: конструкторы идут от корня вниз ----------------

class Node(id) {
    def Node() { println("  1) Node ", id) }
}

class Leaf(id, label) : Node(id) {
    def Leaf() { println("  2) Leaf ", label) }
}

class Marked(id, label, mark) : Leaf(id, label) {
    def Marked() { println("  3) Marked ", mark) }
}

println("создаём Marked:")
m = new Marked(1, "лист", "*")
println(m)      // Marked{"id": 1, "label": "лист", "mark": "*"}

// К телу конструктора объект собран целиком: поля предков уже на месте,
// поэтому в конструкторе можно проверять инвариант или считать производное.

// --- перекрытое поле: позиция от родителя, значение от потомка ---------------

class Base(title = "родитель", extra = "своё")
class Child(title = "потомок") : Base("не видно") {
    // title объявлен и здесь, поэтому побеждает он — как последний в цепочке
}

println(new Child())                // Base-поля идут первыми в порядке печати

// --- аргументы родителю видят параметры потомка ------------------------------

class Sized(side) : Shape("квадрат со стороной " + side) {
    def area() => side * side
}
println(new Sized(3).text())        // квадрат со стороной 3 площадью 9

// --- полиморфизм: разные классы в одном массиве ------------------------------

figures = [new Circle(1), new Square(2), new Ring(3, 1), new Sized(4)]

total = 0
for (figure in figures) {
    println("  ", figure.text())
    total += figure.area()
}
println("суммарная площадь: ", total)

// Отбор по типу — обычное 'is' в обычном условии
for (figure in figures) {
    if (figure is Ring) println("кольцо среди фигур: ", figure.text())
}

// --- порядок объявлений свободен ---------------------------------------------

// Родитель может стоять ниже потомка: объявления верхнего уровня выполняются
// до первой инструкции, и родитель ставится в очередь раньше потомка.
println(new Late().text())          // поздний: и так работает

class Late : Early("поздний") { }
class Early(kind) { def text() => kind + ": и так работает" }

// --- класс от приложения: наследование ему недоступно ------------------------

