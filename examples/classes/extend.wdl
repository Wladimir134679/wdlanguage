// extend: скрипт добавляет свои члены типу или классу.
// Описание — в docs/members.md, раздел «Расширение».
//
// Слова те же, что в теле класса: 'this' — получатель, 'property' — свойство,
// 'def' — метод. Второго имени для того же понятия язык не заводит.

// --- расширение типа ------------------------------------------------------------

extend Array {
    property second => this[1]

    // Деление даёт дробное, а индекс должен быть целым — тут же и пригодился
    // член числа: (this.size / 2).floor.
    property middle => this[(this.size / 2).floor]

    def swap(i, j) {
        item = this[i]
        this[i] = this[j]
        this[j] = item
        return this;
    }
}

items = [10, 20, 30]
println(items.second)               // 20
println(items.middle)               // 20
println(items.swap(0, 2))           // [30, 20, 10]

// Член от расширения виден и через дескриптор — таблица одна на все пути
println(Array.second([1, 2]))       // 2

// --- расширение строки и числа ---------------------------------------------------

extend String {
    property words => this.trimmed.split(" ")

    def shout() => this.upper + "!"
}

extend Number {
    property squared => this * this

    def between(low, high) => this >= low && this <= high
}

println("  тише едешь  ".words)     // ["тише", "едешь"]
println("привет".shout())           // ПРИВЕТ!
println(7.squared)                  // 49
println(7.between(1, 10))           // true

// --- расширение класса ------------------------------------------------------------

class Shape(name)
class Circle(name, radius) : Shape(name)

// В расширении к получателю обращаются явно — 'this.name', а не 'name'. Правило
// одно для типа и для класса: у массива и строки полей нет вовсе, и разрешить голое
// имя только классам значило бы завести два разных 'extend'. Заодно ключ чужого
// объекта не перекрывает глобальные имена.
extend Shape {
    property label => "фигура «" + this.name + "»"
}

extend Circle {
    property area => 3.14159 * this.radius * this.radius
}

circle = new Circle("круг", 2)
println(circle.label)               // фигура «круг» — расширение родителя досталось потомку
println(circle.area)                // 12.56636

// --- расширение работает везде в этом запуске -------------------------------------

def describe(value) => value.label   // функция объявлена ниже extend, но это неважно
println(describe(new Shape("квадрат")))

// --- границы, из которых расширение и состоит --------------------------------------

// Встроенное перекрыть нельзя: скрипт сломал бы не себя, а всё, что работает
// с такими значениями в этом запуске, включая библиотеки.
//
//     extend Array { property size => 0 }
//     // ошибка: у 'Array' уже есть член 'size'
//
// Повторно объявить то же имя тоже нельзя — тихая победа последнего худший исход:
//
//     extend Array { property second => "другое" }
//     // ошибка: член 'second' у 'Array' уже объявлен в этом запуске
//
// Записи у члена типа нет: присваивание в свойство — действие, замаскированное
// под имя, а девать его вдобавок некуда — получатель чужой:
//
//     extend Array { property second { def get() => this[1] def set(v) {} } }
//     // ошибка: у свойства 'second' не бывает 'def set(value)'
//
// И объявлять расширение можно только на верхнем уровне файла: внутри функции
// оно меняло бы поведение уже отработавшего кода в середине запуска.

// 'extend' при этом остаётся обычным именем — ключевого слова язык не отнял
extend = "обычная переменная"
println(extend)
