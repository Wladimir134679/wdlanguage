// Ветвление по одному предмету: match, а под ним — операторы, которыми
// записывается образец. Запуск: wdl examples/match.wdl

// --- match выражением: даёт значение -----------------------------------------
// После case пишется ХВОСТ обычного бинарного выражения, подлежащее которого —
// предмет из заголовка. 'case > 90' читается как «предмет > 90».
cpu = 95

level = match (cpu) {
    case > 90 => "критично"
    case > 70 => "высоко"
    case > 30 => "норма"
    else      => "тихо"
}
println("загрузка ", cpu, "% — ", level)

// В позиции выражения else обязателен: значение должно быть у любого предмета.
// Исчерпаемость в динамическом языке не доказать, а тихий null из непопавшего
// match — ровно тот класс ошибок, который язык ломает там, где написано.
//
// text = match (cpu) { case > 90 => "критично" }
//        ошибка: 'match' в позиции выражения обязан иметь 'else'

// --- голый образец — это неявное равенство -----------------------------------
for (code in 1..4) {
    println(code, " → ", match (code) {
        case 1       => "один"
        case 2, 3    => "два или три"   // перечисление вместо провала из Си
        else         => "много"
    })
}

// --- образец берёт любой бинарный оператор языка -----------------------------
// Своей «системы образцов» у match нет и не нужно: сравнения, is, in, has
// и диапазон — те же операторы, что работают в if.
def describe(value) => match (value) {
    case is Number  => "число"
    case is String  => "строка"
    case is Array   => "массив"
    else            => "что-то ещё"
}
println(describe(5), ", ", describe("текст"), ", ", describe([1, 2]))

admins = ["root", "admin"]
def access(role) => match (role) {
    case in admins   => "полный"
    case !in ["guest"] => "обычный"
    else             => "только чтение"
}
println("root → ", access("root"), "; user → ", access("user"), "; guest → ", access("guest"))

def group(age) => match (age) {
    case in 0..17  => "ребёнок"
    case in 18..65 => "работает"
    else           => "на пенсии"
}
println("10 → ", group(10), "; 42 → ", group(42), "; 80 → ", group(80))

// --- условие в ветке ---------------------------------------------------------
// 'if' после образцов добавляет то, что от предмета не зависит. Ветка бывает
// и из одного условия: предмет при этом по-прежнему один и назван в одном месте.
throttled = true
println("при троттлинге: ", match (cpu) {
    case > 90 if !throttled => "критично"
    case if throttled       => "придержано"
    else                    => "норма"
})

// --- предмет вычисляется один раз --------------------------------------------
// Это и есть главное отличие от цепочки if: total() зовётся однажды, а не
// на каждую ветку. Образцы, наоборот, вычисляются лениво — сверху вниз,
// до первого совпадения.
def total() {
    println("  (считаю сумму)")
    return 120;
}

println("заказ: ", match (total()) {
    case > 100 => "крупный"
    case > 10  => "обычный"
    else       => "мелкий"
})

// --- match инструкцией: ветки делают -----------------------------------------
// Здесь else не обязателен — «значение обязано быть, действие может
// не потребоваться», — а ветка бывает блоком.
command = "add"

match (command) {
    case "add" {
        println("добавляю")
        println("готово")
    }
    case "remove" { println("удаляю") }
    else          { println("неизвестная команда: ", command) }
}

// Ни одна ветка не подошла — инструкция просто ничего не делает
match ("unknown") {
    case "add" { println("сюда не попадём") }
}

// --- ветка в несколько строк: yield отдаёт значение ---------------------------
// В позиции выражения ветка бывает и блоком — тогда значение отдаётся словом
// 'yield'. Слово, а не «последнее выражение блока»: неявный результат читатель
// обязан вычислять сам, а дописанная после него строка молча меняла бы значение.
order = {items: [120, 80, 50], vip: true}

invoice = match (order.items.size) {
    case 0 => "пустой заказ"
    case > 0 {
        total = 0
        for (price in order.items) total += price
        if (order.vip) total = total * 0.9
        yield "к оплате: " + total
    }
    else => "не бывает"
}
println(invoice)

// yield заканчивает ветку — как return заканчивает функцию,
// и работает из любой глубины: из ветвления, из цикла
def firstBig(values) => match (values) {
    case is Array {
        for (value in values) {
            if (value > 100) yield value
        }
        yield 0
    }
    else => 0
}
println("первое больше ста: ", firstBig([5, 40, 130, 200]))

// Ветка, не дошедшая до yield, — ошибка выполнения, а не тихий null:
// значение обязано быть у любого предмета.
//
// text = match (1) { case 1 { if (false) { yield "нет" } } else => "и" }
//     ошибка: ветка 'case' закончилась, не отдав значение
//
// А вот ветке, которая уходит через return, throw или break, yield не нужен:
// управление уходит мимо match целиком.
def nameOf(code) {
    text = match (code) {
        case 0 { return "ноль"; }
        case 1 { yield "один" }
        else   => "много"
    }
    return "получилось: " + text;
}
println(nameOf(0), "; ", nameOf(1), "; ", nameOf(7))

// В позиции инструкции yield недопустим: такой ветке нечего отдавать,
// она просто делает.
//
// match (code) { case 1 { yield "one" } }
//     ошибка: 'yield' допустим только в ветке 'case' у 'match' в позиции выражения

// --- провала нет: break относится к циклу ------------------------------------
// В Си выполненная ветка продолжается в следующую, и break нужен, чтобы этого
// не произошло. Здесь провала нет вовсе, поэтому break в теле ветки означает
// ровно то, что написано: выйти из объемлющего цикла.
for (i in 1..5) {
    match (i) {
        case 4 { break }
        case 2 { continue }
        else   { println("шаг ", i) }
    }
}

// --- фигурная скобка: после '=>' объект, после образца блок -------------------
// Решает то же правило, что и в начале инструкции: место определяет смысл.
point = match (1) {
    case 1 => {x: 0, y: 0}      // объект — стоит в позиции значения
    else   => {x: 1, y: 1}
}
println("точка: ", point.x, ",", point.y)

match (1) {
    case 1 {                    // блок — стоит в позиции инструкции
        shifted = point.x + 1
        println("сдвиг: ", shifted)
    }
}

// --- полное выражение в образце — ошибка разбора ------------------------------
// 'case score > 90' по правилу «после case идёт хвост» значило бы
// «предмет == (score > 90)», то есть тихое «никогда». Отсекается по построению,
// как и 'if (x = 5)'.
//
// match (score) { case score > 90 { println("много") } }
//     ошибка: слева от '>' не нужен операнд: предмет уже назван в 'match (...)'
//
// Скобки снимают запрет — это осознанное сравнение предмета с логическим:
a = 5
b = 3
println("сравнение с логическим: ", match (true) {
    case (a > b) => "a больше"
    else         => "нет"
})

// --- match — обычное выражение -----------------------------------------------
// Значит, он вкладывается куда угодно: в аргумент, в другой match, в возврат.
def weather(temperature, wind) => match (temperature) {
    case > 25 => match (wind) {
        case > 10 => "жарко и ветрено"
        else      => "жарко"
    }
    case > 10 => "нормально"
    else      => "холодно"
}
println(weather(30, 15), "; ", weather(30, 1), "; ", weather(5, 0))
