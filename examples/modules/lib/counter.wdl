// Модуль с состоянием. Переменная count живёт столько же, сколько запуск:
// модуль выполняется один раз, и значение у всех, кто его импортировал, общее.

println("  [counter выполняется — эта строка печатается один раз за запуск]")

count = 0

fun bump(step = 1) {
    count = count + step
    return count;
}
