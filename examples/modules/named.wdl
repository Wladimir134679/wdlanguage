// Сценарий 2. Именованный импорт: в области видимости одно имя, а всё
// остальное достаётся через точку — тем же обращением, что и поле объекта.

import lib.geometry as g

println("typeof(g) = ", typeof(g))
println("сам модуль печатается заголовком: ", g)

println("PI = ", g.PI)
println("площадь круга радиуса 2: ", g.area(2))

// Класс из модуля — обычное значение, поэтому new работает и через точку.
p = new g.Point(6, 8)
println("точка ", p.text(), ", длина ", p.length())

// Обращение к тому же имени двумя записями — одна операция.
println("g.PI и g[\"PI\"] — одно и то же: ", g.PI == g["PI"])

// А вот этих имён здесь нет: именованный импорт ничего не разворачивает.
// println(PI)      // переменная 'PI' не определена
// p = new Point(1, 2)
