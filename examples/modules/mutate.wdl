// Сценарий 8. Модуль изменяем снаружи — ровно так же, как изнутри.
// Импортировав модуль, с ним можно делать всё, что можно его собственному коду:
// переменная меняется, константа остаётся константой (errors/const.wdl),
// а новых имён присваивание не заводит (errors/unknown-assign.wdl).

import lib.counter as c

// Функции модуля считают от того, что положили снаружи: переменная у них общая.
c.count = 100
println("после установки счётчик шагнул до ", c.bump())

// Развёрнутый импорт заводит не копию, а то же самое имя.
import lib.counter

count = 200
println("записали развёрнутым именем, видно через модуль: ", c.count)

c.count = 300
println("записали через модуль, видно развёрнутым именем: ", count)

// Отсюда и цена, и польза: модуль выполняется один раз, значит запись видят все,
// кто его импортировал, — как видят они и работу его функций.
def stepTwice() {
    import lib.counter
    bump()
    bump()
}

stepTwice()
println("после двух шагов из другой области: ", c.count)
