// Сценарий 1. Развёрнутый импорт: имена модуля становятся своими.

import lib.geometry

println("PI = ", PI)
println("площадь круга радиуса 2: ", area(2))

p = new Point(3, 4)
println("точка ", p.text(), ", длина ", p.length())

