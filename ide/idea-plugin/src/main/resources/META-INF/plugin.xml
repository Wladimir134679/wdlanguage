<idea-plugin>
    <id>ru.wds.wdl.idea</id>
    <name>wdl</name>
    <vendor>wds</vendor>

    <description><![CDATA[
        Поддержка языка <b>wdl</b> в IntelliJ IDEA: подсветка, ошибки прямо в редакторе,
        дополнение имён, переход к объявлению, поиск употреблений и структура файла.
        <p>
        Плагин не содержит правил языка — он запускает языковой сервер
        <code>wdl-lsp</code> из дистрибутива wdl. Так подсказка в редакторе и запуск
        скрипта всегда говорят об одном и том же языке.
        <p>
        Сервер ищется в таком порядке: системное свойство <code>wdl.lsp.home</code>,
        переменная окружения <code>WDL_LSP_HOME</code>, сборка
        <code>wdl-lsp/build/install/wdl-lsp</code> внутри открытого проекта,
        затем <code>PATH</code>.
    ]]></description>

    <!-- Клиент LSP доступен только в платных IDE JetBrains. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="ru.wds.wdl.idea.WdlRunConfigurationType"/>
        <lang.parserDefinition language="wdl" implementationClass="ru.wds.wdl.idea.WdlParserDefinition"/>
        <runConfigurationProducer implementation="ru.wds.wdl.idea.WdlRunConfigurationProducer"/>
        <runLineMarkerContributor language="wdl" implementationClass="ru.wds.wdl.idea.WdlRunLineMarkerContributor"/>
        <fileType name="wdl" language="wdl" extensions="wdl"
                  implementationClass="ru.wds.wdl.idea.WdlFileType" fieldName="INSTANCE"/>
        <platform.lsp.serverSupportProvider
                implementation="ru.wds.wdl.idea.WdlLspServerSupportProvider"/>

        <!-- Профилировщик: кнопка «Профилировать», окно с отчётом, подсказки в редакторе. -->
        <executor implementation="ru.wds.wdl.idea.profile.WdlProfileExecutor"/>
        <programRunner implementation="ru.wds.wdl.idea.profile.WdlProfileRunner"/>
        <toolWindow id="wdl Profile" anchor="bottom" canCloseContents="true"
                    icon="AllIcons.Actions.Profile"
                    factoryClass="ru.wds.wdl.idea.profile.WdlProfileToolWindowFactory"/>
        <notificationGroup id="wdl" displayType="BALLOON"/>
    </extensions>

    <projectListeners>
        <listener class="ru.wds.wdl.idea.profile.ProfileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="wdl.profile.open" class="ru.wds.wdl.idea.profile.OpenProfileAction"
                text="Открыть профиль wdl…"
                description="Показать в окне профиля отчёт wdl --profile-out, снятый раньше или на другой машине"
                icon="AllIcons.Actions.Profile">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
